{
  "schemaVersion": "vexlife.intent-scheduler-registry/v0",
  "registryRef": "registry.vexlife.intent-scheduler.001",
  "registryVersion": 1,
  "systemRef": "system.vexlife.intent-scheduler",
  "humanProjectionName": "Intent Queue runtime",
  "purpose": "Admit one exact validated workgraph node at a time to one physical model worker with bounded context, resource, capability and effect leases, recoverable checkpoints, and exact mock tool-result reinjection.",
  "physicalWorkerPolicy": {
    "modelInferenceConcurrency": 1,
    "backgroundModelConcurrencyWhileInteractiveWaits": 0,
    "activeContextLeasesPerWorker": 1,
    "repositoryWritersPerOverlappingClaim": 1,
    "heavyToolAdmission": "CURRENT_RESOURCE_LEASE_REQUIRED"
  },
  "priorityClasses": [
    "INTERACTIVE",
    "EXPEDITE",
    "RECOVERY",
    "NORMAL",
    "BACKGROUND"
  ],
  "priorityRules": {
    "INTERACTIVE": "explicit interactive human turn",
    "EXPEDITE": "IMMEDIATE or HIGH work",
    "RECOVERY": "recovery or unblock work",
    "NORMAL": "ordinary admitted work",
    "BACKGROUND": "LOW or explicitly deferrable background work"
  },
  "fairnessPolicy": {
    "maxDeferrals": 3,
    "rule": "Oldest admitted work beyond maxDeferrals wins within the non-interactive pool; interactive wait still holds all background model work.",
    "sourceDiscardAllowed": false
  },
