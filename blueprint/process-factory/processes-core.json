[
  {
    "processRef": "process.vexlife.interface.render",
    "processVersion": 1,
    "purpose": "Resolve a universal screen contract into one platform-native bounded projection.",
    "applicabilityRules": [
      "screenRef exists",
      "platformRef registered"
    ],
    "requiredInputs": [
      "screenRef",
      "platformRef",
      "localeRef",
      "selectorSnapshotRefs"
    ],
    "optionalInputs": [
      "selectedNodeRef",
      "guideFrameRef"
    ],
    "sourceResolutionRules": [
      "resolve screen and elements from compiled registry",
      "resolve strings from requested locale with declared fallback",
      "resolve design tokens by semantic token ref"
    ],
    "preconditions": [
      "blueprint validation passes",
      "platform adoption state is not BLOCKED"
    ],
    "steps": [
      "resolve-screen-neighborhood",
      "resolve-visible-string-projections",
      "resolve-state-selectors",
      "emit-platform-render-contract"
    ],
    "effectOwnerRule": "platform adapter owns rendering only",
    "authorityEnvelope": {
      "effects": [
        "READ_PROJECTION"
      ],
      "pathScope": []
    },
    "outputTemplateRefs": [
      "template.vexlife.platform-render-contract"
    ],
    "canonicalDispositionVocabulary": [
      "RENDER_CONTRACT_READY",
      "PLATFORM_ADOPTION_REQUIRED",
      "MISSING_CURRENT_SOURCE"
    ],
    "returnRouteRule": "return platform render receipt to caller",
    "closureRule": "close after render receipt hash is recorded",
    "recoveryRule": "discard derived render and rebuild from current blueprint",
    "foundationDependencies": [
      "foundation.vexlife.identity-lattice.v1",
      "foundation.vexlife.state-relay.v1",
      "foundation.vexlife.localization-intent.v1"
    ],
    "downstreamConsumerRefs": [
      "platform.browser",
      "platform.android",
      "platform.ios",
      "platform.windows",
      "platform.macos"
    ],
    "invalidationTriggers": [
      "screen-contract-change",
      "string-contract-change",
      "design-token-change"
    ],
    "testRefs": [
      "test.navigation.screen-frame",
      "test.localization.coverage"
    ]
  },
  {
    "processRef": "process.vexlife.communication.translate-and-refine",
