    "sourceResolutionRules": [
      "resolve immutable accepted records",
      "resolve exact base model and evaluation hashes"
    ],
    "preconditions": [
      "training authority is explicit",
      "hardware resource lease is current",
      "activationRequested is false"
    ],
    "steps": [
      "assemble-dataset-manifest",
      "verify-privacy-coverage",
      "run-isolated-training",
      "save-checkpoint-manifest",
      "evaluate",
      "return-context-review"
