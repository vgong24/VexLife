      "DUPLICATE_IDENTITY",
      "MISSING_PARENT",
      "LOCALIZATION_DEBT",
      "PERMISSION_CONTRACT_REQUIRED"
    ],
    "returnRouteRule": "return registered ref, affected projection refs and validation receipt",
    "closureRule": "close after registry, localization and reference validation pass",
    "recoveryRule": "remove candidate entry or restore prior blueprint object; derived projections rebuild",
    "foundationDependencies": [
      "foundation.vexlife.identity-lattice.v1",
      "foundation.vexlife.localization-intent.v1",
      "foundation.vexlife.permission-effects.v1"
    ],
    "downstreamConsumerRefs": [
      "registry.vexlife.compiled-identities.001",
      "registry.vexlife.strings.001",
      "registry.vexlife.navigation.001"
