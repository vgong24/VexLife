    "returnRouteRule": "return checkpoint and evaluation evidence to Context Review",
    "closureRule": "training closes at accepted inactive, rejected or exact failure receipt",
    "recoveryRule": "delete isolated candidate artifacts only after receipt; accepted prior adapter remains unchanged",
    "foundationDependencies": [
      "foundation.vexlife.evolution-and-dream.v1",
      "foundation.vexlife.permission-effects.v1"
    ],
    "downstreamConsumerRefs": [
      "device-local-explicit-adapter-activation"
    ],
    "invalidationTriggers": [
      "base-model-change",
      "evaluation-change",
      "privacy-receipt-change"
    ],
    "testRefs": [
      "test.evolution.training-does-not-activate"
    ]
