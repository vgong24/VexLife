      ],
      "blocking": true,
      "timeoutMs": 120000
    },
    {
      "checkRef": "check.runtime-recovery",
      "command": "npm run recovery:check",
      "category": "RELIABILITY",
      "purpose": "Runtime recovery causal no-effect receipt and independent PR-ready/Health evidence validate.",
      "lensRefs": [
        "lens.vexlife.intent-and-placement",
        "lens.vexlife.identity-lattice",
        "lens.vexlife.state-and-currentness",
        "lens.vexlife.concurrency-and-relay",
        "lens.vexlife.security-privacy-permission",
        "lens.vexlife.resource-and-context",
