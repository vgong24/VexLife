      ],
      "blocking": true,
      "timeoutMs": 120000
    },
    {
      "checkRef": "check.build-admission",
      "command": "npm run build-admission:check",
      "category": "RELIABILITY",
      "purpose": "One scheduler-admitted request crosses the final effect membrane into one real disposable local Git commit, exact readback, completion, recovery, concern, release, and projection convergence.",
      "lensRefs": [
        "lens.vexlife.intent-and-placement",
        "lens.vexlife.identity-lattice",
        "lens.vexlife.state-and-currentness",
        "lens.vexlife.concurrency-and-relay",
