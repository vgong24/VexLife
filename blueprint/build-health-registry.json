      "lensRefs": [
        "lens.vexlife.usability-and-journey",
        "lens.vexlife.design-system",
        "lens.vexlife.accessibility"
      ],
      "blocking": true
    },
    {
      "checkRef": "check.browser-integration",
      "command": "npm run browser:integration",
      "category": "EXPERIENCE",
      "purpose": "A real headless browser executes project-thread-channel isolation and rendered EN/ZH/JA stable-intent behavior.",
      "lensRefs": [
        "lens.vexlife.usability-and-journey",
        "lens.vexlife.design-system",
