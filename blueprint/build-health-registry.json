      {
        "proofCellRef": "G01_G05A_WINDOWS_PROOFS_WHEN_CURRENTNESS_REQUIRES_RERUN",
        "requiredPlatformId": "windows",
        "reuseAllowed": true
      }
    ],
    "evidenceDispositions": [
      "EXECUTED",
      "REUSED"
    ],
    "reuseContract": {
      "acceptedDisposition": "REUSE",
      "dependencyFingerprintMatchRequired": true,
      "currentnessReceiptIntegrityRequired": true,
      "providerOutageAloneMayAuthorizeReuse": false,
      "currentnessGrantsExecutionAuthority": false
    }
