{
  "schemaVersion": "vexlife.build-health-registry/v0",
  "registryRef": "registry.vexlife.build-health.001",
  "registryVersion": 3,
  "purpose": "One source-managed list of mandatory health checks and the lenses each protects.",
  "semanticNoOpRule": "Equal check inputs and outputs do not create another durable health transition.",
  "checkResultContract": {
    "schemaVersion": "vexlife.check-result-contract/v0",
    "contractRef": "contract.vexlife.check-result-admission.001",
    "outputFormat": "FINAL_JSON_OBJECT",
    "stateField": "state",
    "currentnessField": "currentness",
    "transportStates": [
      "EXECUTED",
      "SPAWN_FAILED",
      "TIMED_OUT"
    ],
    "semanticStates": [
      "PASSED",
      "ATTENTION",
      "NOT_RUN",
      "UNKNOWN",
      "STALE",
      "BLOCKED",
      "FAILED"
    ],
    "stateAdmission": {
      "PASSED": [
        "GROUNDED",
        "VALID",
        "CLEAR",
        "PASS",
        "SYNTAX_VALID",
        "FEATURE_REGISTRY_VALID",
        "HOME_BRIDGE_CONTRACT_VALID",
        "LOCALIZATION_COVERAGE_VALID",
        "PUBLIC_SAFETY_CLEAR",
        "SOURCE_MANIFEST_CURRENT",
        "ARCHITECTURE_PROJECTIONS_WRITTEN",
        "DOCTOR_VALID",
        "CURRENT",
        "BUILD_ADMISSION_CURRENT",
        "BUILD_ADMISSION_SIMULATION_CURRENT"
      ],
      "ATTENTION": [
        "ATTENTION"
      ],
      "NOT_RUN": [
        "NOT_RUN",
        "REGISTERED_NOT_EXECUTED"
      ],
      "UNKNOWN": [
        "UNKNOWN"
      ],
      "STALE": [
        "STALE",
        "SOURCE_MANIFEST_DRIFT"
      ],
      "BLOCKED": [
        "BLOCKED",
        "SOURCE_MANIFEST_BLOCKED"
      ],
      "FAILED": [
        "FAILED"
      ]
    },
    "defaultUnparseableSemanticState": "BLOCKED",
    "defaultTimeoutMs": 120000
  },
