    {
      "checkRef": "check.current",
      "command": "npm run current",
      "category": "CONTINUITY",
      "purpose": "Compact current foundation projection is source-descendable.",
      "lensRefs": [
        "lens.vexlife.state-and-currentness",
        "lens.vexlife.visibility-terrain-health",
        "lens.vexlife.resource-and-context"
      ],
      "blocking": true
    },
    {
      "checkRef": "check.intent-orchestration",
      "command": "npm run intent:check",
      "category": "ARCHITECTURE",
      "purpose": "Immutable intent, deterministic workgraph admission, lifecycle, evidence, convergence, compact projection, and held successor boundaries validate.",
      "lensRefs": [
        "lens.vexlife.intent-and-placement",
        "lens.vexlife.identity-lattice",
        "lens.vexlife.state-and-currentness",
        "lens.vexlife.concurrency-and-relay",
        "lens.vexlife.security-privacy-permission",
