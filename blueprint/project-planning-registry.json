{
  "schemaVersion": "vexlife.project-planning-registry/v1",
  "registryRef": "registry.vexlife.project-planning.001",
  "registryVersion": 1,
  "purpose": "Own project planning-only truth and optimistic planning transactions while delegating work lifecycle mutation to the canonical Intent Workgraph runtime owner.",
  "sourceOwners": {
    "projectProjection": "registry.vexlife.project-continuity.001",
    "workLifecycle": "registry.vexlife.intent-orchestration.001",
    "workRuntimeCurrentness": "source.vexlife.intent-workgraph.runtime-snapshot.001",
    "planningRuntime": "source.vexlife.project-planning.runtime-snapshot.001"
  },
  "schemas": {
    "planningTransaction": "vexlife.project-planning-transaction/v1",
    "planningEvent": "vexlife.project-planning-event/v1",
    "planningSnapshot": "vexlife.project-planning-snapshot/v1",
    "planningRuntimePointer": "vexlife.project-planning-runtime-snapshot/v1",
    "workTransitionRequest": "vexlife.project-work-transition-request/v1"
  },
  "planningEventClasses": [
    {
      "eventClass": "ITERATION_DEFINED",
      "requiredPayloadFields": [
        "iterationRef",
        "label",
        "startsAt",
        "endsAt"
      ]
    },
    {
      "eventClass": "ITERATION_CLOSED",
      "requiredPayloadFields": [
        "iterationRef",
        "closedAt"
      ]
    },
    {
      "eventClass": "ITERATION_MEMBERSHIP_SET",
      "requiredPayloadFields": [
        "workNodeRef",
        "iterationRefOrNull"
      ]
    },
    {
      "eventClass": "SHARED_ORDER_SET",
      "requiredPayloadFields": [
        "scopeRef",
        "orderedWorkNodeRefs"
      ]
    },
    {
      "eventClass": "WIP_POLICY_SET",
      "requiredPayloadFields": [
        "laneRef",
        "limit"
      ]
    },
    {
      "eventClass": "VIEW_SELECTED",
      "requiredPayloadFields": [
        "viewRef"
      ]
    }
  ],
  "planningTruth": [
    "ITERATION_DEFINITION",
    "ITERATION_MEMBERSHIP",
    "SHARED_MANUAL_ORDER",
    "WIP_POLICY",
    "SELECTED_PROJECT_VIEW"
  ],
  "heldTruth": [
    "WORKGRAPH_LIFECYCLE",
    "SOURCE_CURRENTNESS",
    "PROOF_CURRENTNESS",
    "GITHUB_PROVIDER_STATE",
    "PURPOSE_WORKSPACE_RENDERED_STATE"
  ],
  "nonCollapseLaws": [
    "PROJECT_PLANNING != WORKGRAPH",
    "ITERATION_MEMBERSHIP != WORK_STATE",
    "SHARED_ORDER != LIFECYCLE_ORDER",
    "WIP_POLICY != EXECUTION_AUTHORITY",
    "TRANSITION_REQUEST != TRANSITION_ACCEPTED",
    "EXPECTED_CURRENT_POINTER != ATOMIC_CURRENTNESS",
    "BOARD_DRAG != DIRECT_MUTATION",
    "PLANNING_EVENT != PROVIDER_EVENT"
  ]
}
