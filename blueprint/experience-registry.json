  "gestureContracts": [
    {
      "gestureRef": "gesture.vexlife.content-scroll",
      "surfaceKinds": [
        "MESSAGE_FEED",
        "PROJECT_RAIL",
        "DETAIL_PANEL",
        "DOCUMENT"
      ],
      "inputs": [
        "MOUSE_WHEEL",
        "TRACKPAD_SCROLL",
        "TOUCH_DRAG",
        "PAGE_KEYS",
        "ARROW_KEYS"
      ],
      "resultActionRef": "action.content.scroll",
      "rules": [
        "wheel and one-finger vertical movement scroll content",
        "new chat messages append at the bottom",
        "when the reader is away from the bottom preserve position and show a new-message affordance",
        "never reinterpret ordinary scrolling as zoom"
      ],
      "helpStringRef": "gesture.content-scroll.help"
    },
    {
      "gestureRef": "gesture.vexlife.terrain-pan",
      "surfaceKinds": [
        "TERRAIN_CANVAS"
      ],
      "inputs": [
        "BLANK_CANVAS_DRAG",
        "SPACE_PLUS_POINTER_DRAG",
        "TWO_FINGER_SCROLL"
      ],
      "resultActionRef": "action.terrain.canvas.pan",
      "rules": [
        "dragging blank canvas pans",
        "dragging a node moves that node instead of the canvas",
        "text and controls remain selectable",
        "raw pointer paths are ephemeral and never durable journey events"
      ],
      "helpStringRef": "gesture.terrain-pan.help"
    },
    {
      "gestureRef": "gesture.vexlife.terrain-zoom",
      "surfaceKinds": [
        "TERRAIN_CANVAS"
      ],
      "inputs": [
        "PINCH",
        "ZOOM_BUTTON",
        "KEYBOARD_PLUS_MINUS"
      ],
      "resultActionRef": "action.terrain.canvas.zoom",
      "rules": [
        "ordinary wheel scrolling does not zoom by default",
        "zoom has visible controls and a reset route",
        "platform browser zoom and accessibility magnification are not intercepted",
        "zoom retains the selected node and semantic frame",
        "pixel scale never changes semantic depth"
      ],
      "helpStringRef": "gesture.terrain-zoom.help"
    },
    {
      "gestureRef": "gesture.vexlife.node-drag",
      "surfaceKinds": [
        "TERRAIN_NODE"
      ],
      "inputs": [
        "POINTER_DRAG",
        "TOUCH_DRAG",
        "KEYBOARD_MOVE_MODE"
      ],
      "resultActionRef": "action.terrain.node.move",
      "rules": [
        "a movement threshold distinguishes click from drag",
        "movement changes user layout only",
        "canonical parent and child relationships never change",
        "keyboard users receive equivalent move controls"
      ],
      "helpStringRef": "gesture.node-drag.help"
    },
    {
      "gestureRef": "gesture.vexlife.overlay-drag",
      "surfaceKinds": [
        "FLOATING_GUIDE",
        "FLOATING_VESSEL"
      ],
      "inputs": [
        "VISIBLE_HANDLE_DRAG",
        "KEYBOARD_MOVE_MODE"
      ],
      "resultActionRef": "action.guide.move",
      "rules": [
        "only the declared handle moves the overlay",
        "body text remains selectable and scrollable",
        "the overlay remains inside the safe viewport",
        "position is a local preference and not conversational memory"
      ],
      "helpStringRef": "gesture.overlay-drag.help"
    },
    {
      "gestureRef": "gesture.vexlife.navigation-back",
      "surfaceKinds": [
        "APPLICATION"
      ],
      "inputs": [
        "PLATFORM_BACK",
        "ESCAPE",
        "BACK_BUTTON"
      ],
      "resultActionRef": "action.navigation.back",
      "rules": [
        "close transient menu or dialog first",
        "then close or minimize the floating Guide when it owns focus",
        "then return through semantic screen history",
        "exit only through platform-expected behavior and never by surprise"
      ],
      "helpStringRef": "gesture.navigation-back.help"
    },
    {
      "gestureRef": "gesture.vexlife.terrain-semantic-depth",
      "surfaceKinds": [
        "TERRAIN_CANVAS"
      ],
      "inputs": [
        "SEMANTIC_DEPTH_CONTROL",
        "KEYBOARD_BRACKET_KEYS"
      ],
      "resultActionRef": "action.terrain.semantic-depth.set",
      "rules": [
        "semantic depth is changed only through an explicit visible control",
        "semantic depth changes information projection and never pixel scale",
        "semantic depth never mutates canonical parent or child relationships",
        "the selected and centered semantic context remain source-addressable"
      ],
      "helpStringRef": "gesture.terrain-semantic-depth.help"
    },
    {
      "gestureRef": "gesture.vexlife.vessel-resize",
      "surfaceKinds": [
        "FLOATING_GUIDE",
        "FLOATING_VESSEL"
      ],
      "inputs": [
        "CORNER_HANDLE_DRAG",
        "KEYBOARD_RESIZE_MODE"
      ],
      "resultActionRef": "action.vessel.resize",
      "rules": [
        "all four corners expose stable resize handles",
        "body content remains independently selectable and scrollable",
        "resizing respects safe viewport and minimum usable dimensions",
        "vessel size is a local projection preference and not conversational memory"
      ],
      "helpStringRef": "gesture.vessel-resize.help"
    }
  ],
