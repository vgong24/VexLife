      },
      "platformAdapters": {
        "browser": "draggable overlay",
        "android": "overlay, dialog or sheet",
        "ios": "sheet or overlay",
        "windows": "floating window or pane",
        "macos": "panel or window"
      },
      "accessibility": {
        "focusOrderStable": true,
        "dismissible": true,
        "neverObscuresDeclaredControls": true
      }
    },
    {
      "vesselRef": "vessel.vexlife.context",
      "labelStringRef": "vessel.context.name",
      "componentRef": "component.vexlife.action-vessel",
      "purpose": "Entry to the current context map, semantic journey and reply-to-context controls.",
      "actionRefs": [
        "action.context.open"
      ],
      "placement": {
        "wide": "CONTEXT_CARD_ACTION",
        "compact": "NESTED_IN_PRIMARY_VESSEL"
      },
      "platformAdapters": {
        "browser": "popover or panel",
        "android": "sheet or destination",
        "ios": "sheet or destination",
        "windows": "pane",
        "macos": "inspector"
      },
      "accessibility": {
        "focusOrderStable": true,
        "dismissible": true,
        "neverObscuresDeclaredControls": true
      }
    }
  ],
  "guidedEstablishmentPlans": [
    {
