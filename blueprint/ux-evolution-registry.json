  "designLaws": [
    {
      "designLawRef": "law.ux-evolution.one-semantic-state-owner",
      "statement": "Migration accounting never creates a new semantic state owner."
    },
    {
      "designLawRef": "law.ux-evolution.one-active-renderer",
      "statement": "At most one renderer is active for a migrated surface at a time; shadow comparison is evidence, not dual live authority."
    },
    {
      "designLawRef": "law.ux-evolution.rollback-projection-not-user-data",
      "statement": "Projection rollback changes presentation selection only; it never rewinds or forks user data."
    },
    {
      "designLawRef": "law.ux-evolution.new-form-not-new-meaning",
      "statement": "Presentation changes do not create semantic capability unless separately admitted by its rightful owner."
    }
