  "principles": [
    "DISCUSSION_NE_EFFECT",
    "CHECK_STATUS_NE_ADVANCE_STAGE",
    "COPY_SUPPORT_CONTEXT_NE_TRAINING_CONSENT",
    "IMPORTED_GUIDANCE_NE_AUTHORITY",
    "SELECT_FOR_SUPPORT_NE_SELECT_FOR_TRAINING",
    "CONVERSATION_NE_TRAINING_DATA_BY_DEFAULT",
    "MODEL_PROPOSED_LESSON_NE_ACCEPTED_LESSON",
    "PACK_FROZEN_NE_TRAINING_ADMITTED",
    "TRAINING_PLAN_READY_NE_OPTIMIZER_STARTED",
    "COMMAND_FAILED_NE_NO_NEURAL_EFFECT",
    "WEIGHTS_CHANGED_NE_CANDIDATE_GOOD",
    "CANDIDATE_ACCEPTED_NE_CANDIDATE_ACTIVATED",
    "CONTEXT_HANDOFF_NE_EXECUTABLE_RELAY"
  ],
  "humanChapters": [
    {
      "sequence": 0,
      "chapterRef": "chapter.vex-birth.prepare",
      "label": "Prepare",
      "canonicalVBStages": [
        "VB0",
        "VB1"
      ],
      "purpose": "Bind one clean source, isolated Home, qualified learning environment and real G0.",
      "primaryHumanActionRef": "action.birth.prepare-g0",
      "terminalEvidence": [
        "vb0HostSourceReceipt",
        "vb1ProvisioningReceipt"
      ]
    },
    {
      "sequence": 1,
      "chapterRef": "chapter.vex-birth.meet-g0",
      "label": "Meet G0",
      "canonicalVBStages": [
        "VB2"
      ],
      "purpose": "Witness the real untaught G0 before cultivation or training annotations are admitted.",
      "primaryHumanActionRef": "action.birth.baseline.finish",
      "terminalEvidence": [
        "vb2UntaughtBaselineReceipt"
      ]
    },
    {
      "sequence": 2,
      "chapterRef": "chapter.vex-birth.cultivate",
      "label": "Cultivate",
      "canonicalVBStages": [
        "VB3"
      ],
      "purpose": "Talk naturally and form explicit candidate annotations without implicit training consent.",
      "primaryHumanActionRef": "action.birth.cultivation.finish",
      "terminalEvidence": [
        "vb3CultivationReceipt"
      ]
    },
    {
      "sequence": 3,
      "chapterRef": "chapter.vex-birth.review-freeze",
      "label": "Review & Freeze",
      "canonicalVBStages": [
        "VB4",
        "VB5"
      ],
      "purpose": "Review lessons and counterexamples, preserve exclusions, and freeze immutable training and held-out packs.",
      "primaryHumanActionRef": "action.birth.pack.freeze",
      "terminalEvidence": [
        "vb4LessonReviewReceipt",
        "vb5FrozenPackReceipt"
      ]
    },
    {
      "sequence": 4,
      "chapterRef": "chapter.vex-birth.train-compare",
      "label": "Train & Compare",
      "canonicalVBStages": [
        "VB6",
        "VB7",
        "VB8",
        "VB9"
      ],
      "purpose": "Admit one protected run, preserve neural-effect truth, compare G0 and candidate, and record one disposition.",
      "primaryHumanActionRef": "action.birth.foundation.train-candidate",
      "terminalEvidence": [
        "trainingAdmissionReceipt",
        "trainingResultReceipt",
        "evaluationReceipt",
        "dispositionReceipt"
      ]
    },
    {
      "sequence": 5,
      "chapterRef": "chapter.vex-birth.accept-reject-wake",
      "label": "Accept / Reject / Wake",
      "canonicalVBStages": [
        "VB10",
        "VB11",
        "VB12"
      ],
      "purpose": "Register accepted G1, separately activate, witness wake, preserve rollback and replay the route.",
      "primaryHumanActionRef": "action.birth.generation.wake",
      "terminalEvidence": [
        "registrationReceipt",
        "activationReceipt",
        "wakeReceipt",
        "replayReceipt"
      ]
    }
  ],
  "truthClasses": [
    "CURRENT_REAL_LOCAL_G0",
    "CURRENT_REAL_LOCAL_G1",
    "CURRENT_SYNTHETIC_REFERENCE",
    "MODEL_UNAVAILABLE_NO_SYNTHETIC_SUBSTITUTE",
