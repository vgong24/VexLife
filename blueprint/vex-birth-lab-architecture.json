    "POST_OPTIMIZER_CHANGE_UNKNOWN",
    "POST_OPTIMIZER_UNCHANGED",
    "POST_OPTIMIZER_CHANGED"
  ],
  "annotationDispositions": [
    {
      "ref": "TRAIN",
      "meaning": "Candidate formation material",
      "implicitConsent": false
    },
    {
      "ref": "COUNTEREXAMPLE",
      "meaning": "Behavior or overgeneralization to avoid",
      "implicitConsent": false
    },
    {
      "ref": "HELD_OUT",
      "meaning": "Evaluation-only material that must not enter training",
      "implicitConsent": false
    },
    {
      "ref": "DO_NOT_TRAIN",
      "meaning": "Excluded from neural formation",
      "implicitConsent": false
    },
    {
      "ref": "SUPPORT_ONLY",
      "meaning": "Explicitly selected excerpt for external advisory support",
      "implicitConsent": false
    }
  ],
  "provisionalActions": [
    {
      "actionRef": "action.birth.status.inspect",
      "label": "View current birth status",
      "effectClass": "READ_ONLY",
      "permissionRef": "permission.none",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.support.copy",
      "label": "Copy support context",
      "effectClass": "LOCAL_EXPORT",
      "permissionRef": "permission.birth.support-export",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.status-package.generate",
      "label": "Generate status ZIP",
      "effectClass": "LOCAL_EXPORT",
      "permissionRef": "permission.birth.support-export",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.conversation.annotate",
      "label": "Mark selected exchange",
      "effectClass": "LOCAL_CANDIDATE_APPEND",
      "permissionRef": "permission.birth.cultivation-annotate",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.lesson.review",
      "label": "Review lesson",
      "effectClass": "DURABLE_MEANING_REVIEW",
      "permissionRef": "permission.birth.lesson-review",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.pack.freeze",
      "label": "Freeze learning pack",
      "effectClass": "LOCAL_CANDIDATE_APPEND",
      "permissionRef": "permission.birth.pack-freeze",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.training-plan.preflight",
      "label": "Run no-effect preflight",
      "effectClass": "READ_ONLY",
      "permissionRef": "permission.none",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.foundation.train-candidate",
      "label": "Start G1 candidate training",
      "effectClass": "ISOLATED_FOUNDATION_MODEL_TRAINING",
      "permissionRef": "permission.birth.foundation.train",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false,
      "mustNotReuseAs": "action.adapter.train-candidate"
    },
    {
      "actionRef": "action.birth.candidate.disposition",
      "label": "Accept, narrow, or reject candidate",
      "effectClass": "DURABLE_MEANING_REVIEW",
      "permissionRef": "permission.birth.candidate-disposition",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.generation.wake",
      "label": "Wake G1",
      "effectClass": "MODEL_ACTIVATION",
      "permissionRef": "permission.birth.generation-activate",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    },
    {
      "actionRef": "action.birth.generation.rollback",
      "label": "Rollback to G0",
      "effectClass": "MODEL_PROFILE_SELECTION",
      "permissionRef": "permission.birth.generation-activate",
      "acceptedRegistryState": "SOURCE_PLACEMENT_REQUIRED",
      "autoExecute": false
    }
  ],
  "stateReducer": {
    "schemaVersion": "vexlife.vex-birth-lab-state/v1",
    "inputClasses": [
      "sourceCurrentness",
      "lineage",
      "canonicalVBReceipts",
      "workerLifecycles",
      "trainingEffectEvidence",
      "supportSelection"
    ],
    "outputFields": [
      "currentChapter",
      "currentVBStage",
      "activeGenerationRef",
      "candidateGenerationRefOrNull",
      "modelTruthClass",
      "trainingEffectTruth",
      "sourceCurrentness",
      "availableActions",
      "heldActions",
      "blockers",
      "unknowns",
      "latestEvidenceRefs",
      "completionClaimAllowed"
    ],
    "observationalOperationsCannotAdvance": [
      "status.inspect",
      "support.copy",
      "status-package.generate",
      "evidence.view",
      "guidance.import",
      "navigation"
    ]
  },
  "supportContextContract": {
    "schemaVersion": "vexlife.vex-birth-support-context/v1",
    "artifactClass": "CONTEXT_HANDOFF",
    "executable": false,
    "previewRequired": true,
    "include": [
      "birthSessionRef",
      "currentChapter",
      "currentVBStage",
      "activeGenerationRef",
      "candidateGenerationRefOrNull",
      "trainingEffectTruth",
      "sourceCurrentness",
      "availableActionRefsAndLabels",
      "heldActionRefsLabelsAndReasons",
      "blockers",
      "unknowns",
      "selectedExcerptWhenExplicit",
      "boundedLatestEvidenceRefs",
      "humanQuestion"
    ],
    "excludeByDefault": [
      "rawFullTranscript",
      "unselectedHomeContent",
      "unselectedMemoryContent",
      "credentials",
      "absolutePrivatePaths",
      "modelWeights",
      "multiGigabyteArtifacts",
      "executionAuthority"
    ],
    "guidanceConsumption": {
      "authority": "ADVISORY_ONLY",
      "currentActionRefMustExist": true,
      "autoExecute": false
    }
  },
  "statusPackageContract": {
    "artifactClass": "CONTEXT_HANDOFF",
    "executable": false,
    "files": [
      "START-HERE.html",
      "BIRTH-STATUS.json",
      "SUPPORT-CONTEXT.md",
      "CURRENT-STAGE.json",
      "AVAILABLE-ACTIONS.json",
      "REDACTION-MANIFEST.json"
    ],
    "optionalDirectories": [
      "receipts/",
      "plans/",
      "results/",
      "excerpts/"
    ],
    "forbiddenByDefault": [
      "rawFullTranscript",
      "credentials",
      "privateMemory",
      "modelWeightFiles",
      "arbitraryHomeContents",
      "executionTaskManifest"
    ]
  },
  "verifiedRelayComposition": {
    "protocolOwner": "VexLocalBridge",
    "artifactClasses": [
      "CONTEXT_HANDOFF",
      "EXECUTABLE_RELAY",
      "EXECUTION_RETURN"
    ],
    "rules": [
      "FILE_SELECTED_NE_TASK_ADMITTED",
      "TASK_SHAPE_VALID_NE_EFFECT_ADMITTED",
      "RESULT_AVAILABLE_NE_RESULT_CONSUMED",
      "NO_SECOND_RUNNER",
      "NO_SECOND_RETURN_PROTOCOL"
    ]
  },
