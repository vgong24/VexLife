{
  "schemaVersion": "vexlife.project-continuity-registry/v1",
  "registryRef": "registry.vexlife.project-continuity.001",
  "registryVersion": 1,
  "purpose": "Project immutable human outcome and canonical Intent Workgraph truth into bounded read-only Board, Graph, Table and Roadmap views without creating a second work-state owner.",
  "sourceOwners": {
    "workLifecycle": "registry.vexlife.intent-orchestration.001",
    "featureMeaning": "registry.vexlife.features.001",
    "humanWorkspace": "registry.vexlife.purpose-workspaces.001",
    "proofCurrentness": "registry.vexlife.build-health.001",
    "repositoryCurrentness": "orientation.vexlife.dedicated-repository.001",
    "workgraphRuntimeCurrentness": "owner.vexlife.intent-workgraph"
  },
  "schemas": {
    "projectDefinition": "vexlife.project-definition/v1",
    "viewDefinition": "vexlife.project-view-definition/v1",
    "snapshot": "vexlife.project-continuity-snapshot/v1",
    "boardProjection": "vexlife.project-board-projection/v1",
    "graphProjection": "vexlife.project-graph-projection/v1",
    "laneFocusCard": "vexlife.project-lane-focus-card/v1",
    "workgraphRuntimeCurrentPointer": "vexlife.intent-workgraph-runtime-snapshot/v1"
  },
  "viewClasses": [
    "BOARD",
    "GRAPH",
    "TABLE",
    "ROADMAP"
  ],
  "boardLanes": [
    {
      "laneRef": "lane.project.intake",
      "label": "Intake",
      "lifecycleStates": [
        "CAPTURED",
        "NEEDS_CLARIFICATION",
        "DECOMPOSED"
      ]
    },
    {
      "laneRef": "lane.project.planned",
      "label": "Planned",
      "lifecycleStates": [
        "PLAN_VALIDATED",
        "WAITING_DEPENDENCIES"
      ]
    },
    {
      "laneRef": "lane.project.ready",
      "label": "Ready",
      "lifecycleStates": [
        "READY"
      ]
    },
    {
      "laneRef": "lane.project.active",
      "label": "Active",
      "lifecycleStates": [
        "CONTEXT_ADMITTED",
        "RUNNING",
        "WAITING_TOOL"
      ]
    },
    {
      "laneRef": "lane.project.waiting",
      "label": "Waiting",
      "lifecycleStates": [
        "WAITING_RESOURCE",
        "PAUSED_AT_CHECKPOINT"
      ]
    },
    {
      "laneRef": "lane.project.needs-human",
      "label": "Needs Human",
      "lifecycleStates": [
        "WAITING_HUMAN",
        "HELD_UNKNOWN"
      ]
    },
    {
      "laneRef": "lane.project.verify",
      "label": "Verify",
      "lifecycleStates": [
        "VERIFYING"
      ]
    },
    {
      "laneRef": "lane.project.attention",
      "label": "Attention",
      "lifecycleStates": [
        "BLOCKED",
        "FAILED_RECOVERABLE"
      ]
    },
    {
      "laneRef": "lane.project.done",
      "label": "Done",
      "lifecycleStates": [
        "COMPLETED",
        "CONVERGED",
        "CLOSED"
      ]
    },
    {
      "laneRef": "lane.project.archive",
      "label": "Archive",
      "lifecycleStates": [
        "SUPERSEDED",
        "CANCELLED"
      ]
    }
  ],
  "priorityOrder": [
    "IMMEDIATE",
    "HIGH",
    "NORMAL",
    "LOW"
  ],
  "relationshipKinds": [
    "CONTAINS",
    "DEPENDS_ON",
    "RELATES_TO_FEATURE"
  ],
  "timestampFields": [
    "formedAt",
    "createdAt",
    "lastTransitionAt"
  ],
  "heldSuccessors": [
    "iteration membership and sprint planning mutations are P0B-B03",
    "shared ordering and WIP policy mutations are P0B-B03",
    "source/proof/GitHub provider reconciliation is P0B-B04",
    "Purpose Workspace drag/drop Board and Graph adoption is P0B-B05",
    "live ToCompletion project import and dogfood is P0B-B06"
  ],
  "nonCollapseLaws": [
    "PROJECT != FEATURE",
    "FEATURE != EPIC",
    "WORK_NODE != GITHUB_ISSUE",
    "GITHUB_ISSUE != CANONICAL_WORK_STATE",
    "BOARD_COLUMN != WORKGRAPH_LIFECYCLE",
    "PROJECT_VIEW != EFFECT_AUTHORITY",
    "SPRINT_MEMBERSHIP != WORK_STATE",
    "PR_MERGED != WORK_CLOSED",
    "NEWER_TIMESTAMP != STRONGER_TRUTH",
    "VALID_WORKGRAPH != RUNTIME_CURRENT_WORKGRAPH",
    "CURRENT_POINTER_OBSERVED != CURRENT_FOREVER"
  ]
}
