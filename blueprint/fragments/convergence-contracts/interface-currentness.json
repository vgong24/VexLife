        "conditions": ["loadedDocumentSource=currentServerSource", "browserObservationCurrentness=CURRENT", "companionAvailability=READY", "conversationScope=selectedScope", "conversationCurrentness=CURRENT|EMPTY|ABSENT"],
        "semanticState": true,
        "familySemanticState": true,
        "displayState": false,
        "effectCommand": false
      }
    ],
    "invariantIdentities": [
      {"invariantRef":"invariant.vexlife.interface.currentness.independent-input-ownership","code":"INDEPENDENT_INPUT_OWNERSHIP","statement":"Every currentness input retains its rightful independent source owner; the relationship does not become that owner."},
      {"invariantRef":"invariant.vexlife.interface.currentness.latest-coherent-input","code":"LATEST_COHERENT_INPUT_REQUIRED","statement":"No relationship state after UNOBSERVED is derived before every required input has one admitted coherent observation."},
      {"invariantRef":"invariant.vexlife.interface.currentness.output-not-effect","code":"RELATIONSHIP_OUTPUT_NOT_EFFECT_COMMAND","statement":"A derived relationship State never grants or performs navigation, recovery, Conversation, model, setup or source effects."},
      {"invariantRef":"invariant.vexlife.interface.currentness.semantic-not-display","code":"SEMANTIC_STATE_NOT_DISPLAY_STATE","statement":"Portable Interface currentness is semantic Family State; composer controls and human copy remain downstream presentation."},
      {"invariantRef":"invariant.vexlife.interface.currentness.family-handoff","code":"RELATIONSHIP_OUTPUT_HANDS_TO_FAMILY_STATE","statement":"The derived relationship State is the stable semantic State consumed by the rightful Family Circuit before Control-to-Act resolution."},
      {"invariantRef":"invariant.vexlife.interface.currentness.document-server-distinction","code":"LOADED_DOCUMENT_SOURCE_DISTINCT_FROM_CURRENT_SERVER_SOURCE","statement":"A healthy current server never proves that an already-loaded browser document belongs to the same source content."},
      {"invariantRef":"invariant.vexlife.interface.currentness.stale-observation","code":"STALE_OBSERVATION_CANNOT_OVERWRITE_CURRENT_GENERATION","statement":"An older asynchronous observation generation cannot overwrite a newer admitted browser relationship."},
      {"invariantRef":"invariant.vexlife.interface.currentness.ready-selected-conversation","code":"READY_REQUIRES_CURRENT_SELECTED_CONVERSATION","statement":"READY requires exact currentness for the selected project/thread/channel Conversation identity; another Conversation cannot authorize Send."},
      {"invariantRef":"invariant.vexlife.interface.currentness.recovery-not-send-currentness","code":"RECOVERY_TRUTH_DOES_NOT_REQUIRE_SEND_CURRENTNESS","statement":"Canonical same-binding RECOVERABLE or ACTION_REQUIRED truth remains visible even when Conversation Send-currentness is unavailable."},
      {"invariantRef":"invariant.vexlife.interface.currentness.source-mismatch-precedence","code":"SOURCE_MISMATCH_PRECEDES_RECOVERY_PRESENTATION","statement":"A stale loaded document is SOURCE_MISMATCH before Companion recovery/action truth may be presented as current in that document."},
      {"invariantRef":"invariant.vexlife.interface.currentness.source-descent","code":"SOURCE_DESCENT","statement":"Every portable law descends to exact accepted product, Family/Compound reference and semantic-provenance source evidence."},
      {"invariantRef":"invariant.vexlife.interface.currentness.proof-identity","code":"PROOF_OBLIGATION_IDENTITY","statement":"Each portable relationship law has a stable identity that platform realizations and tests can bind without copying the relationship semantics."}
    ],
