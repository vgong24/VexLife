[{"schemaVersion":"vexlife.portable-behavior-contract/v1","contractRef":"contract.vexlife.vexstream.playback.play-pause.001","behaviorRef":"behavior.vexstream.playback.play-pause","ownerBlueprintRef":"blueprint.vexlife.universal.001","purpose":"Own the language-neutral VexStream Play/Pause state, control, act, effect, admission and projection laws before any platform realization.","canonicalSource":{"repository":"vgong24/VexLife","path":"blueprint/fragments/behavior-contracts/vexstream-playback-play-pause.json","compositionField":"behaviorContracts"},"authority":{"portableMeaningOwner":true,"platformRealizationOwner":false,"providerSuccessOwner":false,"executionAuthorityOwner":false},"stateIdentities":[{"stateRef":"state.vexstream.playback.no-media","kind":"NO_MEDIA","brief":"No current media exists, so Play/Pause is unavailable.","conditions":["currentMedia=ABSENT"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.paused-controllable","kind":"MEDIA","brief":"Current media is semantically paused and accepts a Play request.","conditions":["currentMedia=PRESENT","playRequested=false","playPauseAvailable=true","pendingIntent=NONE"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.playing-controllable","kind":"MEDIA","brief":"Current media is semantically playing and accepts a Pause request.","conditions":["currentMedia=PRESENT","playRequested=true","playPauseAvailable=true","pendingIntent=NONE"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.uncontrollable","kind":"MEDIA","brief":"Current media exists but the Play/Pause capability is unavailable.","conditions":["currentMedia=PRESENT","playPauseAvailable=false"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restartable","kind":"ENDED","brief":"Playback ended and the current media can be restarted.","conditions":["currentMedia=PRESENT","restartAvailable=true","pendingIntent=NONE"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restart-pending","kind":"ENDED","brief":"A restart intent is already pending, so another Play/Pause control is unavailable.","conditions":["currentMedia=PRESENT","pendingIntent=RESTART_CURRENT"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restart-unavailable","kind":"ENDED","brief":"Playback ended without an admitted restart capability.","conditions":["currentMedia=PRESENT","restartAvailable=false"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.play-request-pending","kind":"MEDIA","brief":"Play intent is admitted locally while provider acknowledgement remains pending.","conditions":["playRequested=true","pendingIntent=REQUEST_PLAY","playPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.pause-request-pending","kind":"MEDIA","brief":"Pause intent is admitted locally while provider acknowledgement remains pending.","conditions":["playRequested=false","pendingIntent=REQUEST_PAUSE","playPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.play-request-pending.stale-paused-observation","kind":"MEDIA_OBSERVATION","brief":"A stale paused observation arrives after newer Play intent was admitted.","conditions":["pendingIntent=REQUEST_PLAY","providerPlayRequested=false","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.play-request-pending.matching-playing-acknowledgement","kind":"MEDIA_OBSERVATION","brief":"The provider acknowledges the admitted Play intent.","conditions":["pendingIntent=REQUEST_PLAY","providerPlayRequested=true","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.pause-request-pending.stale-playing-observation","kind":"MEDIA_OBSERVATION","brief":"A stale playing observation arrives after newer Pause intent was admitted.","conditions":["pendingIntent=REQUEST_PAUSE","providerPlayRequested=true","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media.pause-request-pending.matching-paused-acknowledgement","kind":"MEDIA_OBSERVATION","brief":"The provider acknowledges the admitted Pause intent.","conditions":["pendingIntent=REQUEST_PAUSE","providerPlayRequested=false","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restart-request-pending.stale-ended-observation","kind":"ENDED_OBSERVATION","brief":"The provider still reports Ended after newer RestartCurrent intent was admitted.","conditions":["pendingIntent=RESTART_CURRENT","providerState=ENDED"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restart-request-pending.media-paused-observation.play-request-remains-pending","kind":"MEDIA_OBSERVATION","brief":"The provider leaves Ended but reports paused Media; restart-specific pending ends while the newer requested Play value remains pending.","conditions":["pendingIntent=RESTART_CURRENT","providerState=MEDIA","providerPlayRequested=false","reconciledPendingIntent=REQUEST_PLAY","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.ended.restart-request-pending.media-playing-acknowledgement","kind":"MEDIA_OBSERVATION","brief":"The provider leaves Ended in a playing semantic state, acknowledging restart completion.","conditions":["pendingIntent=RESTART_CURRENT","providerState=MEDIA","providerPlayRequested=true","providerPlayPauseAvailable=true"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.pending-intent.incompatible-no-media-observation","kind":"NO_MEDIA_OBSERVATION","brief":"Provider observation reports no current media, invalidating any pending Play, Pause or restart intent.","conditions":["pendingIntent=REQUEST_PLAY|REQUEST_PAUSE|RESTART_CURRENT","providerState=NO_MEDIA"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media-pending-intent.incompatible-ended-observation.restartable","kind":"ENDED_OBSERVATION","brief":"Provider observation moves ordinary pending Play/Pause intent to an ended item that can be restarted, invalidating the older pending intent.","conditions":["pendingIntent=REQUEST_PLAY|REQUEST_PAUSE","providerState=ENDED","providerRestartAvailable=true","restartPending=false"],"semanticState":true,"displayState":false},{"stateRef":"state.vexstream.playback.media-pending-intent.incompatible-ended-observation.restart-unavailable","kind":"ENDED_OBSERVATION","brief":"Provider observation moves ordinary pending Play/Pause intent to an ended item without restart capability, invalidating the older pending intent.","conditions":["pendingIntent=REQUEST_PLAY|REQUEST_PAUSE","providerState=ENDED","providerRestartAvailable=false","restartPending=false"],"semanticState":true,"displayState":false}],"controlIdentities":[{"controlRef":"control.vexstream.playback.play-pause","name":"PlayPause","brief":"One user-facing control whose meaning is resolved from current semantic state."}],"actIdentities":[{"actRef":"act.vexstream.playback.play","name":"Play","brief":"The resolved semantic act that requests playing or restarting current media."},{"actRef":"act.vexstream.playback.pause","name":"Pause","brief":"The resolved semantic act that requests pausing current media."}],"effectIdentities":[{"effectRef":"effect.vexstream.playback.request-play","name":"RequestPlay","brief":"Admit Play intent and project it immediately without claiming provider success.","admittedStateRef":"state.vexstream.playback.media.play-request-pending","providerSuccessClaimed":false},{"effectRef":"effect.vexstream.playback.request-pause","name":"RequestPause","brief":"Admit Pause intent and project it immediately without claiming provider success.","admittedStateRef":"state.vexstream.playback.media.pause-request-pending","providerSuccessClaimed":false},{"effectRef":"effect.vexstream.playback.restart-current","name":"RestartCurrent","brief":"Admit restart of the current ended media without claiming provider success.","admittedStateRef":"state.vexstream.playback.ended.restart-pending","providerSuccessClaimed":false}],"projectionIdentities":[{"projectionRef":"projection.vexstream.playback.play-available","name":"PlayAvailable","brief":"The next Play/Pause control would resolve to Play.","executionAuthority":false},{"projectionRef":"projection.vexstream.playback.pause-available","name":"PauseAvailable","brief":"The next Play/Pause control would resolve to Pause.","executionAuthority":false},{"projectionRef":"projection.vexstream.playback.play-pause-unavailable","name":"PlayPauseUnavailable","brief":"The Play/Pause control is unavailable for the current semantic state.","executionAuthority":false}],"invariantIdentities":[{"invariantRef":"invariant.vexstream.playback.control-act-effect-distinction","code":"CONTROL_ACT_EFFECT_DISTINCTION","statement":"Control, resolved Act and runtime Effect remain separate identities."},{"invariantRef":"invariant.vexstream.playback.effect-not-provider-success","code":"EFFECT_NOT_PROVIDER_SUCCESS","statement":"An admitted Effect records requested intent and never proves provider success."},{"invariantRef":"invariant.vexstream.playback.admitted-intent-not-provider-acknowledgement","code":"ADMITTED_INTENT_NOT_PROVIDER_ACKNOWLEDGEMENT","statement":"Local intent admission and provider acknowledgement are distinct transitions."},{"invariantRef":"invariant.vexstream.playback.newer-intent-survives-stale-observation","code":"NEWER_ADMITTED_INTENT_SURVIVES_STALE_PROVIDER_OBSERVATION","statement":"A stale provider observation cannot erase a newer admitted Play, Pause or restart intent."},{"invariantRef":"invariant.vexstream.playback.matching-acknowledgement-clears-pending","code":"MATCHING_ACKNOWLEDGEMENT_CLEARS_PENDING_INTENT","statement":"A provider observation matching the admitted intent clears that pending intent."},{"invariantRef":"invariant.vexstream.playback.pending-intent-changes-next-control-projection","code":"PENDING_INTENT_CHANGES_NEXT_CONTROL_PROJECTION","statement":"An admitted Play or Pause intent changes the next control projection immediately; restart pending remains unavailable."},{"invariantRef":"invariant.vexstream.playback.semantic-state-not-display-state","code":"SEMANTIC_STATE_NOT_DISPLAY_STATE","statement":"Semantic playback state is portable meaning; display state is a downstream presentation classification."},{"invariantRef":"invariant.vexstream.playback.projection-not-execution-authority","code":"PROJECTION_NOT_EXECUTION_AUTHORITY","statement":"A projection describes available meaning and grants no provider or runtime execution authority."},{"invariantRef":"invariant.vexstream.playback.source-descent","code":"SOURCE_DESCENT","statement":"Every row descends to exact current source evidence and the canonical portable owner."},{"invariantRef":"invariant.vexstream.playback.proof-obligation-identity","code":"PROOF_OBLIGATION_IDENTITY","statement":"Each portable law has a stable row identity that downstream generators and proofs can bind exactly."},{"invariantRef":"invariant.vexstream.playback.newer-intent-replaces-older-pending-intent","code":"NEWER_ADMITTED_INTENT_REPLACES_OLDER_PENDING_INTENT","statement":"A newer admitted Play or Pause intent replaces the opposite older pending intent before provider acknowledgement."},{"invariantRef":"invariant.vexstream.playback.incompatible-terminal-observation-clears-pending","code":"INCOMPATIBLE_TERMINAL_OBSERVATION_CLEARS_PENDING_INTENT","statement":"A provider observation proving no current media invalidates pending Play, Pause or restart intent."}],"semanticLawRows":[{"rowRef":"law.vexstream.playback.play-pause.no-media-una