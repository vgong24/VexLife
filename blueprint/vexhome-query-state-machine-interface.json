  "singularityBoundary": {
    "means": [
      "one compact current query/re-entry pointer",
      "coordination over sovereign source owners",
      "bounded source-backed synthesis state"
    ],
    "doesNotMean": [
      "one central database",
      "one universal lattice",
      "one whole-history model prompt",
      "semantic ownership collapse",
      "one always-running agent"
    ]
  },
  "intentBinding": {
    "immutableOwner": "vexlife.intent-workgraph/v0 intent envelope",
    "requiredRefs": [
      "rootIntentRef",
      "rootIntentFingerprint",
      "originMessageRef",
      "originSpeakerRef",
      "originalContentHash",
      "sourceLineageRef"
    ],
    "requiredMeaning": [
      "desiredOutcome",
      "constraints"
    ],
    "rules": [
      "Query evolution references the immutable root Intent rather than rewriting it.",
      "Newly generated questions do not silently replace the originating human goal.",
      "A query may terminate when the originating intent is satisfied even if interesting adjacent questions remain."
    ]
  },
  "queryStateMachine": {
    "phases": [
      "FRONTIER_FORMING",
      "READ_SET_READY",
      "READING",
      "RECONCILING",
      "COVERAGE_SUFFICIENT",
      "COVERAGE_EXPAND_REQUIRED",
      "SOURCE_REFRESH_REQUIRED",
      "SYNTHESIS_READY",
      "TERMINAL_FOR_CURRENT_INTENT"
    ],
    "subordinateToIntentLifecycle": true,
    "queryHeadFields": [
      "queryStateRef",
      "queryLineageRef",
      "rootIntentRef",
      "rootIntentFingerprint",
      "originMessageRef",
      "originSpeakerRef",
      "originalContentHash",
      "desiredOutcomeRefOrBoundedValue",
