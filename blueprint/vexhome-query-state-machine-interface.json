    "RELATIONSHIP_WORLD": "people, groups, directional relationships and relationship lifecycle",
    "PROJECT_TOPOLOGY": "program/project/system relationships and project lifecycle",
    "OWNERSHIP_AUTHORITY": "owner, permission, review, acceptance and blocker topology",
    "IMPLEMENTATION_DEPENDENCY": "contracts, modules, data flow and change impact",
    "EVIDENCE_ASSURANCE": "tests, receipts, review evidence and proof gaps",
    "HISTORY_MEANING": "predecessors, decisions, corrections, journey and meaning evolution",
    "FUTURE_OPEN_LOOPS": "active intents, tasks, commitments, waiting and planned branches",
    "SOURCE_CURRENTNESS": "freshness, source generation, supersession and conflict",
    "STORAGE_PLACEMENT": "logical object to shard/vault/replica/source route"
