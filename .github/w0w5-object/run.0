#!/usr/bin/env bash
set -euo pipefail
npm ci
mkdir -p .github/w0w5-chunks
cat .github/w0w5-object/map.* > /tmp/w0w5-map
while read -r name blob expected; do
  gh api "repos/$GITHUB_REPOSITORY/git/blobs/$blob" --jq '.content' | tr -d '\n' | base64 -d > ".github/w0w5-chunks/$name"
  echo "$expected  .github/w0w5-chunks/$name" | sha256sum -c -
done < /tmp/w0w5-map
test "$(find .github/w0w5-chunks -maxdepth 1 -type f -name '[0-9][0-9]' | wc -l | tr -d ' ')" -eq 30
cat .github/w0w5-chunks/[0-9][0-9] > /tmp/tranche.b64
echo "85b75e8ebad7cf63fb5ddd8cbe68cb6bd2149b25bb3387a6efc584cf5e1cad4a  /tmp/tranche.b64" | sha256sum -c -
base64 -d /tmp/tranche.b64 > /tmp/tranche.tar.gz
echo "357f08ce72e6241f69ae135fc22221112e563c15b3b7dc4dcfedb00ddce6b73b  /tmp/tranche.tar.gz" | sha256sum -c -
python - <<'PYVERIFY'
import pathlib,tarfile
with tarfile.open('/tmp/tranche.tar.gz','r:gz') as archive:
  for member in archive.getmembers():
    path=pathlib.PurePosixPath(member.name)
    if path.is_absolute() or '..' in path.parts or not (member.isdir() or member.isfile()):
      raise SystemExit(f'unsafe member: {member.name}')
  archive.extractall('.')
PYVERIFY
