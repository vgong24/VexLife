node - <<'NODEVERIFY'
const fs=require('node:fs');
const crypto=require('node:crypto');
const inventory=JSON.parse(fs.readFileSync('.tranche/payload-inventory.json','utf8'));
if(!Array.isArray(inventory.files)||inventory.files.length!==30) throw new Error('unexpected payload inventory');
for(const item of inventory.files){
  const content=fs.readFileSync(item.path);
  const hash=crypto.createHash('sha256').update(content).digest('hex');
  if(content.length!==item.bytes||hash!==item.sha256) throw new Error(`payload mismatch ${item.path}`);
}
console.log(JSON.stringify({state:'W0_W5_PAYLOAD_VERIFIED',files:inventory.files.length},null,2));
NODEVERIFY
