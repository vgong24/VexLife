rm.size}/${WARM_CAP}`;$('#historyList').innerHTML=state.history.map((e,i)=>`<button class="history-entry" data-hist="${i}"><strong>#${e.seq} ${tree[e.id].label}</strong><small>depth ${depthOf(e.id)} · ${tree[e.id].kind}</small></button>`).join('');$$('[data-hist]').forEach(b=>b.onclick=async()=>{const i=Number(b.dataset.hist),dir=i<state.cursor?'out':'in';state.cursor=i;recenterRecentWindow();setDrawer(false);await travel(state.history[i].id,dir,false)});$('#back').disabled=state.cursor===0;$('#forward').disabled=state.cursor===state.history.length-1}
function renderDrawer(){$('#drawer').classList.toggle('show',state.drawer);renderVex()}function setDrawer(open){if(open&&!state.drawer){state.drawerReturn=state.vexMode;state.drawer=true;state.vexMode='ambient'}else if(!open&&state.drawer){state.drawer=false;if(state.drawerReturn)state.vexMode=state.drawerReturn;state.drawerReturn=null}renderDrawer()}
function renderBreadcrumb(){const path=pathTo(state.current);$('#breadcrumb').innerHTML=path.map((id,i)=>`<button class="crumb ${i===path.length-1?'current':''}" data-crumb="${id}">${tree[id].label}</button>`).join('<span style="color:var(--faint)">›</span>');$$('[data-crumb]').forEach(b=>b.onclick=()=>travel(b.dataset.crumb,'out'))}

function siblingPair(id=state.current){const p=parentOf[id];if(!p)return{prev:null,next:null};const kids=tree[p].children||[],i=kids.indexOf(id);return{prev:i>0?kids[i-1]:null,next:i>=0&&i<kids.length-1?kids[i+1]:null}}
function renderAdjacent(){const a=$('#adjacent'),pair=siblingPair();const card=(id,dir)=>id?`<button class="adjacent-card ${dir}" data-adj="${id}" data-dir="${dir}"><strong>${dir==='prev'?'‹ ':''}${tree[id].label}${dir==='next'?' ›':''}</strong><small>${(tree[id].children||[]).length} direct · ${descendants(id)} below</small></button>`:'';a.innerHTML=card(pair.prev,'prev')+card(pair.next,'next');$$('[data-adj]').forEach(b=>b.onclick=()=>shiftSibling(b.dataset.adj,b.dataset.dir))}
async function shiftSibling(id,dir){if(state.transitioning||!tree[id])return;state.transitioning=true;resetIntent();const w=$('#world'),c=defaultCamera(),sign=dir==='next'?-1:1;w.classList.add('shift-away');setCamera({scale:c.scale,x:c.x+sign*300,y:c.y},true);await new Promise(r=>setTimeout(r,240));record(id);state.current=id;touchWarm(id);render(false);const nc=defaultCamera();setCamera({scale:nc.scale,x:nc.x-sign*300,y:nc.y},false);w.classList.remove('shift-away');requestAnimationFrame(()=>requestAnimationFrame(()=>{setCamera(nc,true);state.transitioning=false}))}

const intent={candidate:null,confidence:0,outConfidence:0,lastScaleProgress:0};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
function resetIntent(){intent.candidate=null;intent.confidence=0;intent.outConfidence=0;intent.lastScaleProgress=0;renderIntent()}
function renderIntent(){const box=$('#intentTracker'),fill=$('#intentFill');let title='Exploring',detail='Zoom trajectory is not committed yet.',amount=0;if(intent.candidate&&intent.confidence>.08){title=`Approaching ${tree[intent.candidate].label}`;detail=`intent ${Math.round(intent.confidence*100)}% · ${state.autoSemantic?'cross the enter mark to travel':'auto-entry is off'}`;amount=intent.confidence}else if(intent.outConfidence>.08&&parentOf[state.current]){title=`Leaving ${tree[state.current].label}`;detail=`outward intent ${Math.round(intent.outConfidence*100)}% · ${state.autoSemantic?'cross parent mark to return':'auto-entry is off'}`;amount=intent.outConfidence}box.classList.toggle('show',amount>.08);$('#intentTitle').textContent=title;$('#intentDetail').textContent=detail;fill.style.width=Math.round(amount*100)+'%'}
function nearestChildAtScreen(sx,sy){const items=fixedRects(tree[state.current]);if(!items.length)return null;let best=null;for(const p of items){const x=camera.x+p.x*camera.scale,y=camera.y+p.y*camera.scale,d=Math.hypot(sx-x,sy-y);if(!best||d<best.d)best={id:p.id,d}}return best}
function renderZoomRail(){const base=defaultCamera(),ratio=camera.scale/base.scale,min=.50,max=2.15,norm=clamp((ratio-min)/(max-min),0,1);$('#zoomKnob').style.bottom=`calc(${Math.round(norm*100)}% - 7px)`;$('#zoomPercent').textContent=Math.round(ratio*100)+'%';$('#autoSemantic').checked=state.autoSemantic}
function updateZoomIntent({deltaY,sx,sy,nextScale,baseScale}){if(deltaY<0){intent.outConfidence=Math.max(0,intent.outConfidence-.18);const best=nearestChildAtScreen(sx,sy);if(!best||best.d>320){intent.confidence=Math.max(0,intent.confidence-.12);intent.candidate=null;renderIntent();return null}const proximity=clamp(1-best.d/320,0,1),progress=clamp((nextScale/baseScale-1)/.70,0,1);if(intent.candidate===best.id)intent.confidence=clamp(intent.confidence+.07+.14*proximity+.16*Math.max(0,progress-intent.lastScaleProgress),0,1);else{intent.candidate=best.id;intent.confidence=.18+.22*proximity}intent.lastScaleProgress=progress;renderIntent();if(state.autoSemantic&&intent.confidence>=.82&&nextScale>=baseScale*1.70)return{kind:'enter',id:best.id}}else{intent.confidence=Math.max(0,intent.confidence-.2);intent.candidate=null;if(parentOf[state.current]){const progress=clamp((baseScale-nextScale)/(baseScale*.42),0,1);intent.outConfidence=clamp(intent.outConfidence+.07+.16*progress,0,1);if(state.autoSemantic&&intent.outConfidence>=.76&&nextScale<=baseScale*.58){renderIntent();return{kind:'exit',id:parentOf[state.current]}}}renderIntent()}return null}
function zoomAround(sx,sy,factor,deltaY){const base=defaultCamera(),worldX=(sx-camera.x)/camera.scale,worldY=(sy-camera.y)/camera.scale,minScale=Math.max(.24,base.scale*.50),maxScale=Math.min(2.2,base.scale*2.15),nextScale=clamp(camera.scale*factor,minScale,maxScale);setCamera({scale:nextScale,x:sx-worldX*nextScale,y:sy-worldY*nextScale},false);const decision=updateZoomIntent({deltaY,sx,sy,nextScale,baseScale:base.scale});if(decision?.kind==='enter')setTimeout(()=>travel(decision.id,'in'),20);else if(decision?.kind==='exit')setTimeout(()=>travel(decision.id,'out'),20)}

function renderVex(){
  const v=$('#vex');
  v.classList