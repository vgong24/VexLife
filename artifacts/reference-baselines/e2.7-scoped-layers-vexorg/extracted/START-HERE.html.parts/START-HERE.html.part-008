const parentOf={};Object.values(tree).forEach(n=>(n.children||[]).forEach(c=>parentOf[c]=n.id));
const descendants=id=>{let c=0,q=[...(tree[id]?.children||[])];while(q.length){const x=q.shift();c++;q.push(...(tree[x]?.children||[]))}return c};
const depthOf=id=>{let d=0,x=id;while(parentOf[x]){d++;x=parentOf[x]}return d};
const pathTo=id=>{const a=[];let x=id;while(x){a.unshift(x);x=parentOf[x]}return a};
