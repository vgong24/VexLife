<!doctype html>
<html lang="en" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>VexLife E2.7 — Scoped Layers + VexOrg Sandbox</title>
<style>
:root{--bg:#0f1012;--surface:#17181c;--raised:#202126;--overlay:#272930;--line:#383a42;--strong:#5a5d68;--text:#f5f5f4;--muted:#b7b8bf;--faint:#858791;--accent:#f2f2ef;--accentText:#111216;--warn:#e9c46a;--info:#9bb7d4;--shadow:0 18px 55px rgba(0,0,0,.35);--serif:Georgia,'Times New Roman',serif;--sans:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;--mono:ui-monospace,'SFMono-Regular',Menlo,monospace}
html[data-theme="light"]{--bg:#f2f2f0;--surface:#fff;--raised:#f5f5f3;--overlay:#ececea;--line:#d6d6d2;--strong:#aaa9a4;--text:#17181b;--muted:#565861;--faint:#7f8189;--accent:#17181b;--accentText:#fff;--warn:#805500;--info:#315d8a;--shadow:0 18px 55px rgba(30,30,25,.15)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans)}button,select,input{font:inherit;color:inherit}button{cursor:pointer}svg{display:block}
.review{min-height:100vh;padding:16px 18px 34px}.review-head{max-width:1580px;margin:0 auto 14px;display:flex;gap:16px;justify-content:space-between;align-items:end;flex-wrap:wrap}.review-head h1{font:700 clamp(30px,4vw,58px)/.98 var(--serif);margin:0}.review-head p{max-width:880px;color:var(--muted);line-height:1.45;margin:7px 0 0}.truth{font:700 10px var(--mono);letter-spacing:.1em;border:1px solid var(--line);border-radius:999px;padding:7px 10px}
.baseline-strip{max-width:1580px;margin:0 auto 12px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:10px 12px;display:flex;gap:8px;align-items:center;overflow-x:auto;white-space:nowrap}.baseline-strip strong{font-size:12px}.sig{border:1px solid var(--line);border-radius:999px;padding:5px 8px;font-size:10px;color:var(--muted)}.sig.new{border-color:var(--warn);color:var(--text)}
.controls{max-width:1580px;margin:0 auto 12px;border:1px solid var(--line);background:var(--surface);border-radius:15px;padding:9px;display:flex;gap:8px;flex-wrap:wrap;align-items:center}.group{display:flex;gap:5px;align-items:center}.label{font:700 9px var(--mono);letter-spacing:.11em;color:var(--faint);margin-left:5px}.ctrl{border:1px solid var(--line);background:var(--raised);border-radius:9px;padding:7px 10px}.ctrl.active{background:var(--accent);color:var(--accentText)}.ctrl:disabled{opacity:.35;cursor:not-allowed}
.device-wrap{max-width:1580px;margin:0 auto;display:flex;justify-content:center}.frame{width:100%;border:1px solid var(--line);border-radius:22px;background:var(--surface);overflow:hidden;box-shadow:var(--shadow);transition:width .2s ease}.frame.mobile{width:430px}.app{height:900px;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto;background:var(--surface);position:relative;overflow:hidden}.mobile .app{height:820px}
.appbar{height:70px;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:10px 14px;gap:12px;z-index:40;background:color-mix(in srgb,var(--surface) 96%,transparent)}.mark{width:46px;height:46px;border:1px solid var(--line);border-radius:14px;background:var(--raised);display:grid;place-items:center}.mark svg{width:28px;height:28px}.brand strong{display:block}.brand small{display:block;font:650 9px var(--mono);letter-spacing:.1em;color:var(--faint);margin-top:2px}.actions{margin-left:auto;display:flex;gap:6px}.actions button{border:1px solid var(--line);background:var(--raised);border-radius:9px;padding:8px 10px}
.breadcrumb{display:flex;gap:5px;padding:8px 14px;border-bottom:1px solid var(--line);overflow:auto;white-space:nowrap}.crumb{border:0;background:transparent;color:var(--muted);padding:5px 7px;border-radius:8px;font-size:11px}.crumb.current{color:var(--text);background:var(--raised);font-weight:700}
.terrain{position:relative;overflow:hidden;background:radial-gradient(circle at 50% 48%,color-mix(in srgb,var(--info) 6%,transparent),transparent 34%),linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:auto,54px 54px,54px 54px}
.hud{position:absolute;left:12px;top:12px;z-index:25;display:flex;gap:6px;flex-wrap:wrap;pointer-events:none}.hud span{font:700 9px var(--mono);letter-spacing:.06em;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 91%,transparent);border-radius:999px;padding:6px 8px;color:var(--muted)}
.world{position:absolute;width:1200px;height:800px;transform-origin:0 0;will-change:transform,opacity;transition:transform .34s cubic-bezier(.2,.75,.2,1),opacity .22s ease}.world.travel-in{opacity:.16}.world.travel-out{opacity:.18}.world.shift-away{opacity:.3}.world.arriving{transition:none;opacity:.12}.edge-svg{position:absolute;inset:0;width:1200px;height:800px;pointer-events:none;z-index:1}.edge{stroke:var(--strong);stroke-width:2;opacity:.62;vector-effect:non-scaling-stroke}
.focus{position:absolute;left:600px;top:400px;width:320px;min-height:170px;transform:translate(-50%,-50%);z-index:6;border:1px solid var(--strong);border-radius:22px;background:var(--surface);padding:17px;box-shadow:var(--shadow)}.focus.surface{width:590px;max-height:410px;overflow:auto}.focus .eyebrow,.node .eyebrow{font:750 9px var(--mono);letter-spacing:.12em;color:var(--faint);text-transform:uppercase}.focus h2{font:700 31px/1.03 var(--serif);margin:8px 0}.focus p{font-size:13px;line-height:1.45;color:var(--muted)}.facts{display:flex;gap:5px;flex-wrap:wrap}.pill{border:1px solid var(--line);border-radius:999px;padding:4px 7px;font-size:9px;color:var(--muted)}
.node{position:absolute;width:180px;min-height:100px;transform:translate(-50%,-50%);z-index:5;border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:11px;text-align:left;box-shadow:0 8px 22px rgba(0,0,0,.16)}.node:hover,.node:focus-visible{border-color:var(--strong);z-index:8}.node strong{display:block;font-size:13px;margin:5px 0 3px}.node small{font-siz