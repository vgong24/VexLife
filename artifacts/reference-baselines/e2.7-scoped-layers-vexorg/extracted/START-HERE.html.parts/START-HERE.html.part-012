.toggle('ambient',state.vexMode==='ambient');
  v.classList.toggle('focused',state.vexMode==='expanded');
  v.style.opacity=state.vexMode==='ambient'?Math.max(.35,state.vexOpacity/100):1;
  if(state.vexMode==='ambient'||state.device==='mobile'){
    v.style.width='';v.style.height='';
  }else if(state.vexDims){
    v.style.width=state.vexDims.width+'px';v.style.height=state.vexDims.height+'px';
  }else{
    v.style.width=state.vexSize==='small'?'285px':state.vexSize==='large'?'430px':'340px';
    v.style.height=state.vexSize==='small'?'270px':state.vexSize==='large'?'470px':'330px';
  }
  if(state.vexPos&&state.device==='desktop'){
    v.style.left=state.vexPos.left+'px';v.style.top=state.vexPos.top+'px';v.style.right='auto';v.style.bottom='auto';
  }else{
    v.style.left='';v.style.right='14px';
    if(state.device==='mobile'){v.style.top='auto';v.style.bottom='82px'}else{v.style.top='92px';v.style.bottom='auto'}
  }
  const orgNote=inVexOrg()?'<br><br><strong>VexOrg boundary:</strong> I can use the organization-visible lens shown here. Private human-partner context is not employer-visible by default.':'';
  $('#vexBody').innerHTML=`<strong>${tree[state.current].label}</strong><br>${tree[state.current].summary}<br><br>I stay with the current Terrain layer. Ask me about the relationship, why it matters, or where to go next.${orgNote}`;
}
function render(animate=true){document.documentElement.dataset.theme=state.theme;$('#frame').className='frame '+state.device;$$('[data-geometry]').forEach(b=>b.classList.toggle('active',b.dataset.geometry===state.geometry));$$('[data-theme-choice]').forEach(b=>b.classList.toggle('active',b.dataset.themeChoice===state.theme));$$('[data-device]').forEach(b=>b.classList.toggle('active',b.dataset.device===state.device));$('#orgLensGroup').classList.toggle('show',inVexOrg());$$('[data-org-lens]').forEach(b=>b.classList.toggle('active',b.dataset.orgLens===state.orgLens));$('#scopeChip').innerHTML=`interaction scope · <strong>${scopeName()}</strong>`;const n=tree[state.current],items=fixedRects(n),f=$('#focus');f.className='focus '+(['page','actions','person','project','orgPolicy'].includes(n.kind)?'surface scroll-scope':'');f.innerHTML=surfaceHTML(n);const fr=focusRect(n);f.style.left=(fr.x+fr.width/2)+'px';f.style.top=(fr.y+fr.height/2)+'px';f.style.width=fr.width+'px';f.style.minHeight=fr.height+'px';restoreCurrentScopeScroll();const box=$('#nodes');box.innerHTML='';items.forEach(p=>{const c=tree[p.id],b=document.createElement('button');b.className='node';b.dataset.nodeId=p.id;b.innerHTML=`<span class="count">${(c.children||[]).length||''}</span><span class="eyebrow">${c.q||c.kind}</span><strong>${c.label}</strong><small>${c.meta}</small>`;b.style.left=p.x+'px';b.style.top=p.y+'px';if(state.geometry==='carousel'){b.style.transform=`translate(-50%,-50%) scale(${p.scale}) rotateY(${-Math.max(-42,Math.min(42,p.z*15))}deg)`;b.style.opacity=String(Math.max(.48,1-Math.abs(p.z)*.13))}b.onclick=()=>state.workspaceMode?toast('Projection workspace: drag cards; toggle workspace off to enter nodes'):travel(p.id,'in');box.appendChild(b)});updateEdges(items,n);$('#hud').innerHTML=`<span>DEPTH ${depthOf(n.id)}</span><span>${n.kind.toUpperCase()}</span><span>${childrenFor(n).length} NEXT</span><span>${descendants(n.id)} BELOW</span>`;renderBreadcrumb();renderJourney();renderDrawer();renderAdjacent();renderVex();$('#up').disabled=!parentOf[state.current];$('#workspaceBadge').classList.toggle('show',state.workspaceMode);$$('[data-action]').forEach(b=>b.onclick=()=>toast(`${b.dataset.action} · mock selection only`));
$$('[data-kudos-action]').forEach(b=>b.onclick=()=>toast(`Kudos ${b.dataset.kudosAction} · mock recipient-controlled action`));
$$('[data-org-action="ack-move"]').forEach(b=>b.onclick=()=>{const p=state.orgProposals[state.current];if(p){p.status='PERSON_ACKNOWLEDGED__NOT_EFFECTIVE_IN_MOCK';render(false);toast('Proposal acknowledged · assignment unchanged in this mock')}});
if(animate&&!state.transitioning)setCamera(defaultCamera(),false)}
function toast(t){const e=$('#toast');e.textContent=t;e.classList.add('show');clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove('show'),1400)}
$$('[data-geometry]').forEach(b=>b.onclick=()=>{state.geometry=b.dataset.geometry;resetIntent();render()});$$('[data-org-lens]').forEach(b=>b.onclick=()=>{state.orgLens=b.dataset.orgLens;state.localOffsets={};resetIntent();render()});$$('[data-theme-choice]').forEach(b=>b.onclick=()=>{state.theme=b.dataset.themeChoice;render(false)});$$('[data-device]').forEach(b=>b.onclick=()=>{state.device=b.dataset.device;state.vexPos=null;state.vexMode=state.device==='mobile'?'ambient':'expanded';resetIntent();render();setCamera(defaultCamera(),true)});$('#back').onclick=back;$('#forward').onclick=forward;$('#up').onclick=up;$('#reset').onclick=()=>{state.current='relationship';state.history=[{id:'relationship',seq:1}];state.cursor=0;state.nextSeq=2;state.recentWindowStart=0;state.recentBrowse=false;state.localOffsets={};state.workspaceMode=false;state.orgLens='structure';state.orgProposals={};state.vexDims=null;state.scrollScopes={};warm.clear();resetIntent();render()};$('#historyBtn').onclick=()=>setDrawer(!state.drawer);$('#closeDrawer').onclick=()=>setDrawer(false);$('#summon').onclick=()=>{setDrawer(false);state.vexMode='expanded';renderVex()};$('#vexRecede').onclick=()=>{state.vexMode=state.vexMode==='ambient'?'expanded':'ambient';renderVex()};$('#recedeVex').onclick=()=>{state.vexMode='ambient';closePresenceMenu();renderVex()};$('#vexMenu').onclick=e=>{e.stopPropagation();const open=!$('#presenceMenu').classList.contains('show');$('#presenceMenu').classList.toggle('show',open);$('#vexMenu').classList.toggle('active',open);$('#vexMenu').setAttribute('aria-pressed',String(open))};$('#opacity').oninput=e=>{state.vexOpacity=Number(e.target.value);$('#opacityValue').textContent=e.target.value+'%';renderVex()};$$('[data-size]').forEach(b=>b.onclick=()=>{state.vexSize=b.dataset.size;stat