ind==='project'?'project surface':'embedded surface';
  return 'Terrain layer';
}
function fixedRects(n){const ids=childrenFor(n).slice(0,8),cx=600,cy=400;let pts=[];if(state.geometry==='fan'){const start=-158,end=-22,rx=430,ry=255;pts=ids.map((id,i)=>{const a=(start+(ids.length===1?68:i*(end-start)/(ids.length-1)))*Math.PI/180;return{id,x:cx+Math.cos(a)*rx,y:cy+Math.sin(a)*ry,scale:1,z:0}})}else if(state.geometry==='rings'){const r=330;pts=ids.map((id,i)=>{const a=(-90+i*360/ids.length)*Math.PI/180;return{id,x:cx+Math.cos(a)*r,y:cy+Math.sin(a)*r,scale:1,z:0}})}else{const spread=150,mid=(ids.length-1)/2;pts=ids.map((id,i)=>{const d=i-mid;return{id,x:cx+d*spread,y:205+Math.abs(d)*22,scale:Math.max(.64,1-Math.abs(d)*.1),z:d}})}return pts.map(p=>{const o=state.localOffsets[p.id]||{x:0,y:0};return{...p,x:p.x+o.x,y:p.y+o.y}})}
const focusRect=n=>['page','actions','person','project','orgPolicy'].includes(n.kind)?{x:305,y:185,width:590,height:430}:{x:440,y:315,width:320,height:170};
function childRect(p){return{x:p.x-90,y:p.y-50,width:180,height:100}}function center(r){return{x:r.x+r.width/2,y:r.y+r.height/2}}function anchor(r,t){const c=center(r),dx=t.x-c.x,dy=t.y-c.y;if(!dx&&!dy)return c;const sx=dx===0?Infinity:(r.width/2)/Math.abs(dx),sy=dy===0?Infinity:(r.height/2)/Math.abs(dy),k=Math.min(sx,sy);return{x:c.x+dx*k,y:c.y+dy*k}}
function updateEdges(items,n){const svg=$('#edges');svg.innerHTML='';const fr=focusRect(n),fc=center(fr);items.forEach(p=>{const cr=childRect(p),cc=center(cr),a=anchor(fr,cc),b=anchor(cr,fc),l=document.createElementNS('http://www.w3.org/2000/svg','line');l.setAttribute('class','edge');l.setAttribute('x1',a.x);l.setAttribute('y1',a.y);l.setAttribute('x2',b.x);l.setAttribute('y2',b.y);svg.appendChild(l)})}
let camera={scale:1,x:0,y:0};function defaultCamera(){const t=$('#terrain').getBoundingClientRect();let scale=state.device==='mobile'?0.72:Math.min(1,(t.width-30)/1120,(t.height-30)/720);scale=Math.max(.48,Math.min(1,scale));return{scale,x:t.width/2-600*scale,y:t.height/2-400*scale}}function setCamera(c,animate=true){camera={scale:c.scale,x:c.x,y:c.y};const w=$('#world');w.style.transition=animate?'transform .34s cubic-bezier(.2,.75,.2,1),opacity .22s ease':'none';w.style.transform=`translate(${c.x}px,${c.y}px) scale(${c.scale})`;renderZoomRail()}
function cameraForPoint(wx,wy,zoom){const t=$('#terrain').getBoundingClientRect();return{scale:zoom,x:t.width/2-wx*zoom,y:t.height/2-wy*zoom}}
function surfaceHTML(n){
  const direct=childrenFor(n).length;
  const base=`<div class="eyebrow">${n.kind.toUpperCase()} · DEPTH ${depthOf(n.id)}</div><h2>${n.label}</h2><p>${n.summary}</p>`;
  if(n.kind==='page')return base+`<div class="facts"><span class="pill">${warm.has(n.id)?'warm':'rehydrated'}</span><span class="pill">journey persists separately</span></div><div class="embed"><div class="embed-head">embedded page surface · nested scroll scope</div><div class="embed-body scroll-scope"><h3>${n.label}</h3><p style="color:var(--muted);font-size:10px">Scrolling here belongs to this surface. It does not also zoom or scroll the parent Terrain layer.</p><div class="section-grid">${(n.sections||[]).map((s,i)=>`<div class="mini"><strong>Section ${i+1}</strong><small>${s}</small></div>`).join('')}<div class="mini"><strong>More content</strong><small>This extra mock content makes the embedded surface independently scrollable so scope behavior can be tested.</small></div><div class="mini"><strong>Nested state</strong><small>Child interaction is contained; parent navigation stays stable until an explicit layer gesture occurs.</small></div></div></div></div>`;
  if(n.kind==='actions')return base+`<div class="action-grid scroll-scope">${(n.actions||[]).map(a=>`<button data-action="${a}"><strong>${a}</strong><small>synthetic quick action</small></button>`).join('')}</div>`;
  if(n.kind==='org')return base+`<div class="facts"><span class="pill">${direct} visible in ${state.orgLens}</span><span class="pill">no individual velocity score</span><span class="pill">synthetic org data</span></div><div class="org-banner"><strong>VexOrg lens: ${state.orgLens}</strong><small>Structure, projects and contribution are alternate semantic projections over the same organization. Changing the lens does not rewrite the organization.</small></div>`;
  if(n.kind==='department')return base+`<div class="facts"><span class="pill">${direct} direct</span><span class="pill">${descendants(n.id)} below</span></div><div class="org-banner"><strong>Department scope</strong><small>Department leaders see shared team/project state. Private human+Vex context remains outside this scope.</small></div>`;
  if(n.kind==='team')return base+`<div class="facts"><span class="pill">${direct} visible</span><span class="pill">capacity = declared/role-based</span></div><div class="org-banner"><strong>Team scope</strong><small>Projects and people can be related without converting contribution into a surveillance ranking. Resource planning uses commitments, role fit and declared availability.</small></div>`;
  if(n.kind==='project'){
    const p=n.project||{};
    return base+`<div class="org-grid"><div class="org-card"><strong>Status</strong><small>${p.status||'UNKNOWN'}</small></div><div class="org-card"><strong>Milestones</strong><small>${p.milestones||'—'}</small></div><div class="org-card"><strong>Resource need</strong><small>${p.need||'—'}</small></div><div class="org-card"><strong>Teams</strong><small>${(p.teams||[]).join(' · ')||'—'}</small></div></div><div class="org-banner"><strong>Project risk</strong><small>${p.risk||'—'}</small></div>`;
  }
  if(n.kind==='person'){
    const p=n.person||{},proposal=state.orgProposals[n.id];
    return base+`<div class="org-grid"><div class="org-card"><strong>Role</strong><small>${p.role||'—'}</small></div><div class="org-card"><strong>Team</strong><small>${p.team||'—'}</small></div><div class="org-card"><strong>Declared capacity</strong><small>${p.declaredCapacity||'—'}</small></div><div class="or