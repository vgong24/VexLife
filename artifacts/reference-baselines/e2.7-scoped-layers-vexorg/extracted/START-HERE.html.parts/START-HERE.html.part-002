e:10px;line-height:1.3;color:var(--muted)}.node .count{position:absolute;right:8px;top:8px;font:700 9px var(--mono);color:var(--faint)}
.embed{margin-top:10px;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--raised)}.embed-head{border-bottom:1px solid var(--line);padding:7px 9px;color:var(--muted);font-size:10px}.embed-body{padding:11px}.embed-body h3{font:700 22px var(--serif);margin:0 0 6px}.section-grid,.action-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;margin-top:9px}.mini,.action-grid button{border:1px solid var(--line);background:var(--surface);border-radius:9px;padding:8px;text-align:left;font-size:10px}.mini strong,.action-grid strong{display:block;margin-bottom:3px}.mini small,.action-grid small{color:var(--muted)}
.recentbar{border-top:1px solid var(--line);background:var(--surface);min-height:70px;padding:8px 12px;display:grid;grid-template-columns:auto auto minmax(0,1fr) auto auto;gap:7px;align-items:center}.recent-title{font:700 9px var(--mono);letter-spacing:.08em;color:var(--faint)}.recent{display:flex;gap:5px;overflow:hidden;justify-content:center}.recent-edge{width:28px;height:28px;border:1px solid var(--line);background:var(--raised);border-radius:999px;display:grid;place-items:center;font-size:16px;padding:0}.recent-edge:disabled{opacity:.18;cursor:default}.visit{border:1px solid var(--line);background:var(--raised);border-radius:999px;padding:6px 8px;font-size:9px;white-space:nowrap;color:var(--muted);max-width:180px;overflow:hidden;text-overflow:ellipsis}.visit.current{color:var(--text);border-color:var(--strong);font-weight:700;box-shadow:0 0 0 1px color-mix(in srgb,var(--accent) 20%,transparent)}.journey-meta{font:650 9px var(--mono);color:var(--faint);white-space:nowrap}
.drawer{position:absolute;top:70px;bottom:70px;left:0;width:min(380px,88%);z-index:50;background:var(--surface);border-right:1px solid var(--line);box-shadow:var(--shadow);transform:translateX(-102%);transition:transform .2s ease;overflow:auto;padding:14px}.drawer.show{transform:translateX(0)}.drawer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.drawer-head h3{margin:0;font:700 24px var(--serif)}.drawer-head button{border:0;background:transparent;font-size:20px}.history-entry{width:100%;border:1px solid var(--line);background:var(--raised);border-radius:11px;padding:9px;margin:6px 0;text-align:left}.history-entry strong{display:block}.history-entry small{color:var(--muted)}
.vex{position:absolute;right:14px;top:92px;bottom:auto;width:340px;height:330px;z-index:45;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(16px);border-radius:17px;box-shadow:var(--shadow);overflow:hidden;opacity:.62;transition:opacity .16s ease,height .16s ease,width .16s ease,transform .16s ease}.vex:hover,.vex.focused{opacity:1}.vex.ambient{height:58px;width:260px}.vex.ambient .vex-body,.vex.ambient .composer{display:none}.vex-head{height:58px;padding:8px 10px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--line);cursor:grab;touch-action:none}.vex.dragging .vex-head{cursor:grabbing}.vex-head svg{width:27px;height:27px}.vex-head strong{flex:1}.vex-head button{border:1px solid var(--line);background:var(--raised);border-radius:8px;padding:5px 8px}.vex-body{padding:11px;color:var(--muted);font-size:11px;line-height:1.45;height:200px;overflow:auto}.vex-body strong{color:var(--text)}.composer{border-top:1px solid var(--line);padding:8px;display:flex;gap:6px}.composer input{flex:1;min-width:0;border:1px solid var(--line);background:var(--raised);border-radius:9px;padding:8px}.composer button{border:0;background:var(--accent);color:var(--accentText);border-radius:9px;padding:8px 10px}.presence-menu{position:absolute;right:12px;bottom:422px;z-index:60;width:235px;border:1px solid var(--line);background:var(--overlay);border-radius:13px;padding:10px;box-shadow:var(--shadow);display:none}.presence-menu.show{display:block}.vex-head button.active{background:var(--accent);color:var(--accentText);border-color:var(--accent)}.presence-menu label{font-size:10px;color:var(--muted);display:block;margin:7px 0}.presence-menu input[type=range]{width:100%}.menu-row{display:flex;gap:5px}.menu-row button{flex:1;border:1px solid var(--line);background:var(--raised);border-radius:8px;padding:6px;font-size:10px}

.terrain{touch-action:none;cursor:grab}.terrain.panning{cursor:grabbing}
.intent-tracker{position:absolute;top:12px;right:12px;z-index:27;min-width:205px;max-width:300px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(12px);border-radius:13px;padding:9px 10px;opacity:0;transform:translateY(-5px);transition:opacity .14s ease,transform .14s ease;pointer-events:none}.intent-tracker.show{opacity:1;transform:none}.intent-tracker strong{display:block;font-size:10px}.intent-tracker small{display:block;color:var(--muted);font-size:9px;margin-top:3px}.intent-bar{height:3px;background:var(--line);border-radius:999px;margin-top:6px;overflow:hidden}.intent-fill{height:100%;width:0;background:var(--accent);transition:width .08s linear}
.zoom-rail{position:absolute;left:12px;top:64px;z-index:29;width:38px;display:grid;justify-items:center;gap:6px;color:var(--muted)}.zoom-btn{width:30px;height:30px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(10px);border-radius:9px;font-size:16px;padding:0}.zoom-track{height:196px;width:28px;border:1px solid var(--line);background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(10px);border-radius:999px;position:relative}.zoom-track::before{content:"";position:absolute;left:13px;top:14px;bottom:14px;width:2px;background:var(--line)}.zoom-knob{position:absolute;left:6px;width:14px;height:14px;border-radius:50%;background:var(--accent);border:2px solid var(--surface);transform:translateY(50%);